<Application x:Class="BaudioApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BaudioApp.Helpers">
    <Application.Resources>

        <!-- Converters -->
        <helpers:EqualityToVisibilityConverter x:Key="EqVis"/>
        <helpers:InequalityToVisibilityConverter x:Key="NeqVis"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolVis"/>
        <helpers:StateToColorConverter x:Key="StateColor"/>
        <helpers:PeakToWidthConverter x:Key="PeakWidth"/>
        <helpers:PeakToBarHeightConverter x:Key="PeakBarHeight"/>

        <!-- Color tokens -->
        <SolidColorBrush x:Key="AccentBrush"   Color="#00C853"/>
        <SolidColorBrush x:Key="ErrorBrush"    Color="#FF5252"/>
        <SolidColorBrush x:Key="WarnBrush"     Color="#FF8C00"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#4A4A4A"/>
        <SolidColorBrush x:Key="Surface"       Color="#272727"/>
        <SolidColorBrush x:Key="Surface2"      Color="#303030"/>
        <SolidColorBrush x:Key="PopupBg"       Color="#1C1C1C"/>
        <SolidColorBrush x:Key="DividerBrush"  Color="#14FFFFFF"/>

    </Application.Resources>
</Application>
