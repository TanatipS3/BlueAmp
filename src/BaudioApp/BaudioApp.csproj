<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\tray-idle.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Lightweight footprint: workstation, non-concurrent GC keeps a mostly-idle
         tray app's memory low instead of reserving heap headroom for throughput. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- Build/Publish Size Optimization -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\tray-idle.ico"      CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="Assets\tray-connected.ico" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="Assets\tray-error.ico"     CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
