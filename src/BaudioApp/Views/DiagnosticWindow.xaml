<Window x:Class="BaudioApp.Views.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BaudioApp.Models"
        Title="BlueAmp — Diagnostics"
        Width="580" Height="480"
        MinWidth="400" MinHeight="280"
        Background="#1A1A1A"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Level dot color -->
        <Style x:Key="LevelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Log list -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Toolbar: filter chips + Clear -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="FILTER" FontSize="10" Foreground="#444444"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold"/>
                    <RadioButton Content="All"        GroupName="Filter" IsChecked="True"
                                 Command="{Binding FilterCommand}" CommandParameter="All"
                                 Margin="0,0,6,0" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <RadioButton Content="Connection" GroupName="Filter"
                                 Command="{Binding FilterCommand}" CommandParameter="Connection"
                                 Margin="0,0,6,0" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <RadioButton Content="Audio"      GroupName="Filter"
                                 Command="{Binding FilterCommand}" CommandParameter="Audio"
                                 Margin="0,0,6,0" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <RadioButton Content="Errors"     GroupName="Filter"
                                 Command="{Binding FilterCommand}" CommandParameter="Errors"
                                 Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy" Command="{Binding CopyCommand}"
                            Background="#2A2A2A" Foreground="#666666" BorderThickness="0"
                            Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Clear" Command="{Binding ClearCommand}"
                            Background="#2A2A2A" Foreground="#666666" BorderThickness="0"
                            Padding="10,4" FontSize="11" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log entries -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,6">
            <ItemsControl ItemsSource="{Binding FilteredEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DiagnosticEntry}">
                        <Border Padding="10,8" Margin="0,2" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0AFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>   <!-- Timestamp -->
                                    <ColumnDefinition Width="12"/>   <!-- Dot -->
                                    <ColumnDefinition Width="*"/>    <!-- Message -->
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                           FontSize="10" FontFamily="Consolas, monospace"
                                           Foreground="#444444" VerticalAlignment="Top" Margin="0,1,8,0"/>

                                <!-- Level dot -->
                                <Ellipse Grid.Column="1" Margin="0,3,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource LevelDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Fill" Value="#00C853"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Fill" Value="#FF8C00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Fill" Value="#FF5252"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Info">
                                                    <Setter Property="Fill" Value="#555555"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="12" Foreground="#E0E0E0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="11" Foreground="#555555"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding Detail,
                                                   Converter={StaticResource BoolVis},
                                                   ConverterParameter=NotNull}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer: event count + live indicator -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <TextBlock HorizontalAlignment="Left" FontSize="11" Foreground="#444444">
                    <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
                    <Run Text="events"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="6" Height="6" Fill="#00C853" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00C853" BlurRadius="4" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Live" FontSize="11" Foreground="#444444"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
