<Window x:Class="BaudioApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — BlueAmp"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="#1A1A1A"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Toggle switch style -->
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="10" Background="#3A3A3A">
                            <Ellipse x:Name="Knob" Width="14" Height="14"
                                     Fill="White" Margin="3,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000" BlurRadius="3" ShadowDepth="1" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00C853"/>
                                <Setter TargetName="Knob"  Property="Margin"     Value="0,0,3,0"/>
                                <Setter TargetName="Knob"  Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting row style -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="BorderBrush" Value="#0CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙" FontSize="13" Foreground="#555555" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Settings — BlueAmp" FontSize="12" FontWeight="SemiBold"
                           Foreground="#888888" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20,16,20,16">

            <!-- General section -->
            <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold"
                       Foreground="#4A4A4A"
                       Margin="0,0,0,6"/>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Launch at startup" FontSize="13" Foreground="#F0F0F0" FontWeight="Medium"/>
                        <TextBlock Text="Start BlueAmp automatically when Windows starts"
                                   FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Style="{StaticResource ToggleStyle}"
                                  IsChecked="{Binding LaunchAtStartup}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Remember last device" FontSize="13" Foreground="#F0F0F0" FontWeight="Medium"/>
                        <TextBlock Text="Auto-connect to the last used Bluetooth device on launch"
                                   FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Style="{StaticResource ToggleStyle}"
                                  IsChecked="{Binding RememberLastDevice}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Auto-reconnect on drop" FontSize="13" Foreground="#F0F0F0" FontWeight="Medium"/>
                        <TextBlock Text="Retry connection automatically if the audio stream drops"
                                   FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Style="{StaticResource ToggleStyle}"
                                  IsChecked="{Binding AutoReconnect}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Diagnostics section -->
            <TextBlock Text="DIAGNOSTICS" FontSize="10" FontWeight="Bold"
                       Foreground="#4A4A4A"
                       Margin="0,16,0,6"/>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Enable diagnostic logging" FontSize="13" Foreground="#F0F0F0" FontWeight="Medium"/>
                        <TextBlock Text="Off by default to stay lightweight. Errors are always recorded; turn this on to capture full activity when troubleshooting."
                                   FontSize="11" Foreground="#888888" Margin="0,2,0,0"
                                   TextWrapping="Wrap" MaxWidth="340"/>
                    </StackPanel>
                    <ToggleButton Style="{StaticResource ToggleStyle}"
                                  IsChecked="{Binding KeepLogHistory}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Presence Detection section -->
            <TextBlock Text="PRESENCE DETECTION" FontSize="10" FontWeight="Bold"
                       Foreground="#4A4A4A"
                       Margin="0,16,0,6"/>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Lock PC when phone leaves" FontSize="13" Foreground="#F0F0F0" FontWeight="Medium"/>
                        <TextBlock Text="Use Bluetooth signal strength to detect when you've walked away. May increase CPU usage."
                                   FontSize="11" Foreground="#888888" Margin="0,2,0,0"
                                   TextWrapping="Wrap" MaxWidth="340"/>
                    </StackPanel>
                    <ToggleButton Style="{StaticResource ToggleStyle}"
                                  IsChecked="{Binding PresenceDetection}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <TextBlock Text="BlueAmp v1.0.0 · Windows 10 2004+"
                           FontSize="11" Foreground="#3A3A3A" VerticalAlignment="Center"/>
                <Button Content="Save" HorizontalAlignment="Right"
                        Command="{Binding SaveCommand}"
                        Background="#00C853" Foreground="#000000"
                        BorderThickness="0" Padding="18,6"
                        FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
