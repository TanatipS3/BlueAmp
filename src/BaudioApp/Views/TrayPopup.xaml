<UserControl x:Class="BaudioApp.Views.TrayPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BaudioApp.Models"
             Width="320"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- Connect button style -->
        <Style x:Key="BtnConnect" TargetType="Button">
            <Setter Property="Background" Value="#00C853"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disconnect button style -->
        <Style x:Key="BtnDisconnect" TargetType="Button">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Retry button style -->
        <Style x:Key="BtnRetry" TargetType="Button">
            <Setter Property="Background" Value="#1EFF5252"/>
            <Setter Property="Foreground" Value="#FF5252"/>
            <Setter Property="BorderBrush" Value="#38FF5252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel (connecting) button style -->
        <Style x:Key="BtnCancel" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A4A4A"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link button style (Settings / Diagnostics footer) -->
        <Style x:Key="BtnLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                            RelativeSource={RelativeSource AncestorType=Button}}"
                                            Value="True">
                                            <Setter Property="Foreground" Value="#888888"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F01C1C1C"
            BorderBrush="#18FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>

            <!-- ── Header ── -->
            <Grid Margin="2,2,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status dot: color + glow via DataTrigger, blink animation inline (no TargetName) -->
                <Ellipse Grid.Column="0"
                         Width="8" Height="8"
                         VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#555555"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverallState}" Value="Connecting">
                                    <Setter Property="Fill" Value="#FF8C00"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="DotBlinkSB">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25"
                                                                 Duration="0:0:0.55" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="DotBlinkSB"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallState}" Value="Connected">
                                    <Setter Property="Fill" Value="#00C853"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#00C853" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallState}" Value="Error">
                                    <Setter Property="Fill" Value="#FF5252"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FF5252" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Text="BlueAmp"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>

                <!-- Connected device label (right side) -->
                <TextBlock Grid.Column="2"
                           Text="{Binding ConnectedDevice.Name}"
                           FontSize="11" Foreground="#555555"
                           VerticalAlignment="Center"
                           Visibility="{Binding OverallState,
                               Converter={StaticResource EqVis},
                               ConverterParameter=Connected}"/>
            </Grid>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,0,0,6"/>

            <!-- ── Device list ── -->
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BluetoothDeviceInfo}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- BT icon -->
                            <Viewbox Grid.Column="0" Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 2 L15.5 5.5 L12 9 Z
                                               M12 15 L15.5 18.5 L12 22 Z
                                               M8.5 5.5 L12 9 L8.5 12.5
                                               M8.5 18.5 L12 15 L8.5 11.5"
                                          StrokeThickness="1.8" StrokeLineJoin="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="#555555"/>
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                                        <Setter Property="Stroke" Value="#00C853"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                                        <Setter Property="Stroke" Value="#FF5252"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                        <Setter Property="Stroke" Value="#FF8C00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <!-- Device name + sub-text -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13" Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11" Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Available"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                    <Setter Property="Text" Value="Connecting…"/>
                                                    <Setter Property="Foreground" Value="#FF8C00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                                    <Setter Property="Text" Value="Connected · A2DP"/>
                                                    <Setter Property="Foreground" Value="#00C853"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter Property="Text" Value="Connection failed"/>
                                                    <Setter Property="Foreground" Value="#FF5252"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Action button area -->
                            <Grid Grid.Column="2">

                                <!-- Connect -->
                                <Button Content="Connect"
                                        Style="{StaticResource BtnConnect}"
                                        Command="{Binding DataContext.ConnectCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding State,
                                            Converter={StaticResource EqVis},
                                            ConverterParameter=Available}"/>

                                <!-- Connecting: spinner + Cancel -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding State,
                                                Converter={StaticResource EqVis},
                                                ConverterParameter=Connecting}">
                                    <!-- Spinner: rotation animated inline, no TargetName needed -->
                                    <TextBlock Text="○" FontSize="12" Foreground="#555555"
                                               VerticalAlignment="Center" Margin="0,0,4,0"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SpinSB">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                        From="0" To="360" Duration="0:0:0.9"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SpinSB"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Cancel"
                                            Style="{StaticResource BtnCancel}"
                                            Command="{Binding DataContext.CancelCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>

                                <!-- Disconnect -->
                                <Button Content="Disconnect"
                                        Style="{StaticResource BtnDisconnect}"
                                        Command="{Binding DataContext.DisconnectCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding State,
                                            Converter={StaticResource EqVis},
                                            ConverterParameter=Connected}"/>

                                <!-- Retry -->
                                <Button Content="Retry"
                                        Style="{StaticResource BtnRetry}"
                                        Command="{Binding DataContext.ConnectCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding State,
                                            Converter={StaticResource EqVis},
                                            ConverterParameter=Error}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <TextBlock Text="No paired Bluetooth audio devices found"
                       FontSize="12" Foreground="#444444"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ── Stats panel (Connected only) ── -->
            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding OverallState,
                            Converter={StaticResource EqVis},
                            ConverterParameter=Connected}">

                <!-- 3 stat boxes: Codec · Bitrate · Quality -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Codec -->
                    <Border Grid.Column="0" Background="#222222" CornerRadius="6"
                            Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="CODEC" FontSize="9" Foreground="#444444"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Codec}" FontSize="15"
                                       Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Bitrate -->
                    <Border Grid.Column="1" Background="#222222" CornerRadius="6"
                            Padding="10,8" Margin="2,0">
                        <StackPanel>
                            <TextBlock Text="BITRATE" FontSize="9" Foreground="#444444"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock FontSize="15" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold">
                                <Run Text="{Binding Bitrate, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Quality (signal bars) -->
                    <Border Grid.Column="2" Background="#222222" CornerRadius="6"
                            Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="QUALITY" FontSize="9" Foreground="#444444"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <!-- 4 signal bars (Border supports CornerRadius; Rectangle does not) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="5" Height="6" CornerRadius="1" Margin="0,0,3,0"
                                        VerticalAlignment="Bottom" Background="#00C853"/>
                                <Border Width="5" Height="10" CornerRadius="1" Margin="0,0,3,0"
                                        VerticalAlignment="Bottom">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SignalBars}" Value="2">
                                                    <Setter Property="Background" Value="#00C853"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SignalBars}" Value="3">
                                                    <Setter Property="Background" Value="#00C853"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SignalBars}" Value="4">
                                                    <Setter Property="Background" Value="#00C853"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="5" Height="14" CornerRadius="1" Margin="0,0,3,0"
                                        VerticalAlignment="Bottom">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SignalBars}" Value="3">
                                                    <Setter Property="Background" Value="#00C853"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SignalBars}" Value="4">
                                                    <Setter Property="Background" Value="#00C853"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="5" Height="18" CornerRadius="1" VerticalAlignment="Bottom">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SignalBars}" Value="4">
                                                    <Setter Property="Background" Value="#00C853"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Audio stream waveform -->
                <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Label row -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Audio stream" FontSize="10" Foreground="#555555"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Silent"/>
                                        <Setter Property="Foreground" Value="#444444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectedDevice.IsAudioActive}" Value="True">
                                                <Setter Property="Text" Value="Active"/>
                                                <Setter Property="Foreground" Value="#00C853"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Scrolling waveform bars -->
                        <ItemsControl ItemsSource="{Binding PeakHistory}" Height="28">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="9" Margin="1,0" VerticalAlignment="Bottom"
                                            CornerRadius="2"
                                            Height="{Binding Converter={StaticResource PeakBarHeight}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#00C853" Offset="0"/>
                                                <GradientStop Color="#69F0AE" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── Error box ── -->
            <Border Margin="0,10,0,0"
                    Background="#1AFF5252" BorderBrush="#38FF5252" BorderThickness="1"
                    CornerRadius="6" Padding="10,8"
                    Visibility="{Binding OverallState,
                        Converter={StaticResource EqVis},
                        ConverterParameter=Error}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12" Foreground="#FF5252"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ── Footer ── -->
            <Grid Margin="0,12,0,2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Settings"
                            Style="{StaticResource BtnLink}"
                            Command="{Binding OpenSettingsCommand}"/>
                    <TextBlock Text="·" Foreground="#333333" Margin="6,0" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Button Content="Diagnostics"
                            Style="{StaticResource BtnLink}"
                            Command="{Binding OpenDiagnosticsCommand}"/>
                </StackPanel>
                <TextBlock Text="BlueAmp v1"
                           FontSize="10" Foreground="#333333"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

        </StackPanel>
    </Border>

</UserControl>
